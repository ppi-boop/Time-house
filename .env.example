# WhatsApp number that receives every order enquiry.
# Country code + number. No "+", no spaces, no dashes.
# Example: India +91 98765 43210  ->  919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Absolute site URL, used for canonical links, sitemap and OG images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store identity (shown in the header, footer, contact page and LocalBusiness schema)
NEXT_PUBLIC_STORE_NAME=Time House
NEXT_PUBLIC_STORE_EMAIL=hello@timehouse.example.com
NEXT_PUBLIC_STORE_PHONE=+919876543210

# MongoDB Atlas connection for the catalogue and the admin panel.
# Server-side only — never prefix this with NEXT_PUBLIC_.
MONGODB_URI=

# Signs the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=

# Admin password, hashed. Set with: npm run admin:password -- 'your password'
ADMIN_PASSWORD_HASH=

# Cloudinary — where uploaded pictures are stored and served from. Required:
# without these three, the picture fields in the admin panel cannot upload.
# Free account at https://cloudinary.com → Dashboard shows all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
